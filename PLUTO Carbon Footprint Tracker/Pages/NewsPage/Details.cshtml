@page "{id:int?}"
@model PLUTO_Carbon_Footprint_Tracker.Pages.NewsPage.DetailsModel

@{
    ViewData["Title"] = "News Details";
}

<h1>@Model.NewsArticle.Title</h1>

<p><strong>Date:</strong> @Model.NewsArticle.PublishedAt.ToString("dd MMM yyyy")</p>

@if (!string.IsNullOrWhiteSpace(Model.NewsArticle.ImageUrl))
{
    <img src="@Model.NewsArticle.ImageUrl" alt="@Model.NewsArticle.Title"
    class="img-fluid rounded mb-3"
    style="max-height: 500px; object-fit: cover; width: 80%;" />
}

<div class="card">
    <div class="card-body">
        <p>@Model.NewsArticle.Content</p>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index" class="btn btn-secondary">Back to News</a>
</div>