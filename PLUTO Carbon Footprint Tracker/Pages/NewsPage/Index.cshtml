@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.NewsPage.IndexModel

@{
    ViewData["Title"] = "News";
}

<style>
    body {
        background: #eef5ee;
        font-family: 'Segoe UI', sans-serif;
    }

    .header {
        background: #4caf50;
        color: white;
        padding: 14px;
        text-align: center;
        font-weight: 600;
        position: relative;
    }

        .header .left {
            position: absolute;
            left: 15px;
        }

        .header .right {
            position: absolute;
            right: 15px;
        }

    .icon-btn {
        text-decoration: none;
        color: white;
        font-size: 18px;
        padding: 4px;
        border-radius: 6px;
    }

        .icon-btn:hover {
            background: rgba(255,255,255,0.2);
            color: white;
        }

    .content {
        padding: 12px;
    }

    .featured {
        background: #dff0d8;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 12px;
    }

        .featured img {
            width: 100%;
            height: 160px;
            object-fit: cover;
        }

    .featured-title {
        padding: 10px;
        font-weight: 500;
        text-align: center;
    }

    .news-item {
        background: #fff;
        border-radius: 10px;
        padding: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .news-item-text {
        font-size: 14px;
        color: #1b3a1b;
        flex: 1;
    }

    .news-thumb {
        width: 60px;
        height: 60px;
        background: #ccc;
        border-radius: 6px;
        margin-left: 10px;
        object-fit: cover;
    }

    .footer {
        background: #e8f5e9;
        padding: 10px 0;
        display: flex;
        justify-content: space-around;
        border-top: 1px solid #c8e6c9;
    }

        .footer div {
            text-align: center;
            font-size: 12px;
            color: #2e7d32;
        }
</style>

<div class="app">

    <div class="header">
        <a asp-page="/SettingsPage/Index" class="left icon-btn">⚙</a>
        News
        <a asp-page="/UserProfile/Index" class="right icon-btn">👤</a>
    </div>

    <div class="content">

        @if (Model.CurrentNews.Any())
        {
            var featured = Model.CurrentNews.First();

            <a asp-page="./Details" asp-route-id="@featured.Id" style="text-decoration:none; color:inherit;">
                <div class="featured">
                    @if (!string.IsNullOrWhiteSpace(featured.ImageUrl))
                    {
                        <img src="@featured.ImageUrl" />
                    }
                    <div class="featured-title">
                        @featured.Title
                    </div>
                </div>
            </a>

            @foreach (var article in Model.CurrentNews.Skip(1))
            {
                <a asp-page="./Details" asp-route-id="@article.Id" style="text-decoration:none;">
                    <div class="news-item">

                        <div class="news-item-text">
                            @article.Title
                        </div>

                        @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                        {
                            <img src="@article.ImageUrl" class="news-thumb" />
                        }
                        else
                        {
                            <div class="news-thumb"></div>
                        }

                    </div>
                </a>
            }
        }
        else
        {
            <div>No news available.</div>
        }
        <div class="d-flex justify-content-between align-items-center">
            <h2>More News</h2>
            <a asp-page="./AllNews">See all &gt;</a>
        </div>
        @if (Model.MoreNews.Any())
        {
            @foreach (var article in Model.MoreNews)
            {
                <a asp-page="./Details" asp-route-id="@article.Id" style="text-decoration:none;">
                    <div class="news-item">

                        <div class="news-item-text">
                            @article.Title
                        </div>

                        @if (!string.IsNullOrWhiteSpace(article.ImageUrl))
                        {
                            <img src="@article.ImageUrl" class="news-thumb" />
                        }
                        else
                        {
                            <div class="news-thumb"></div>
                        }

                    </div>
                </a>
            }
        }
    </div>



</div>