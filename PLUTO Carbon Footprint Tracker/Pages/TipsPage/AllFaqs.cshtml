@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.TipsPage.AllFaqsModel

@{
    ViewData["Title"] = "All FAQs";
}

<h1>All FAQs</h1>

<form method="get" class="mb-3">
    <div class="form-group">
        <label for="searchTerm" class="control-label">Search FAQs</label>
        <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control" />
    </div>

    <div class="form-group mt-2">
        <input type="submit" value="Search" class="btn btn-primary" />
        <a asp-page="./Index" class="btn btn-secondary">Back to Tips</a>
    </div>
</form>

@if (Model.FaqItems.Any())
{
    <div class="card mb-3">
        @foreach (var faq in Model.FaqItems)
        {
            <div class="card-body border-bottom">
                <h4>@faq.Title</h4>
                <a asp-page="./Details" asp-route-id="@faq.Id" class="btn btn-primary">View Details</a>
            </div>
        }
    </div>
}
else
{
    <p>No FAQs found.</p>
}