@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.TipsPage.AllTipsModel

@{
    ViewData["Title"] = "All Tips";
}

<h1>All Tips</h1>

<form method="get" class="mb-3">
    <div class="form-group">
        <label for="searchTerm" class="control-label">Search Tips</label>
        <input type="text" id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control" />
    </div>

    <div class="form-group mt-2">
        <input type="submit" value="Search" class="btn btn-primary" />
        <a asp-page="./Index" class="btn btn-secondary">Back to Tips</a>
    </div>
</form>

@if (Model.TipItems.Any())
{
    <div class="card mb-3">
        @foreach (var tip in Model.TipItems)
        {
            <div class="card-body border-bottom">
                <h4>@tip.Title</h4>

                @if (!string.IsNullOrWhiteSpace(tip.ActivityTypeName))
                {
                    <p><strong>Category:</strong> @tip.ActivityTypeName</p>
                }
                <a asp-page="./Details" asp-route-id="@tip.Id" class="btn btn-primary">View Details</a>
            </div>
        }
    </div>
}
else
{
    <p>No tips found.</p>
}