@page "{id:int?}"
@model PLUTO_Carbon_Footprint_Tracker.Pages.TipsPage.DetailsModel

@{
    ViewData["Title"] = "Tip Details";
}

<h1>@Model.Tip.Title</h1>

@if (Model.Tip.ActivityType != null)
{
    <p>
        <strong>Category:</strong> @Model.Tip.ActivityType.Name
    </p>
}

<div class="card mb-3">
    <div class="card-body">
        <p>@Model.Tip.Content</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Tip.VideoUrl))
{
    <div class="mb-3">
        <iframe width="560" height="315"
                src="@Model.Tip.VideoUrl"
                frameborder="0"
                allowfullscreen>
        </iframe>
    </div>
}

<div>
    <a asp-page="./Index" class="btn btn-secondary">Back to Tips</a>
</div>