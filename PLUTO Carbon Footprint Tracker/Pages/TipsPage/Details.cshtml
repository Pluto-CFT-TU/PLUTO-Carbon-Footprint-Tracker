@page "{id:int?}"
@model PLUTO_Carbon_Footprint_Tracker.Pages.TipsPage.DetailsModel

@{
    ViewData["Title"] = "Tip Details";
}

<style>
    body {
        background: #eef5ee;
        font-family: 'Segoe UI', sans-serif;
    }

    .header {
        background: #4caf50;
        color: white;
        padding: 14px;
        text-align: center;
        font-weight: 600;
        position: relative;
    }

        .header .back {
            position: absolute;
            left: 15px;
            top: 14px;
            text-decoration: none;
            color: white;
            font-size: 18px;
        }

        .header .profile {
            position: absolute;
            right: 15px;
            top: 14px;
        }

    .content {
        padding: 14px;
    }

    .title {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 8px;
        color: #1b3a1b;
    }

    .category {
        font-size: 13px;
        color: #666;
        margin-bottom: 12px;
    }

    .media-box {
        background: #ddd;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 12px;
    }

        .media-box iframe {
            width: 100%;
            height: 500px;
            border: none;
        }

    .text-box {
        background: #ffffff;
        padding: 12px;
        border-radius: 12px;
        font-size: 14px;
        line-height: 1.5;
        color: #333;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .footer {
        background: #e8f5e9;
        padding: 10px 0;
        display: flex;
        justify-content: space-around;
        border-top: 1px solid #c8e6c9;
        margin-top: 10px;
    }

        .footer div {
            text-align: center;
            font-size: 12px;
            color: #2e7d32;
        }
</style>

<div class="app">

    <div class="header">
        <a asp-page="./Index" class="back">←</a>
        Tips
    </div>

    <div class="content">

        <div class="title">
            @Model.Tip.Title
        </div>

        @if (Model.Tip.ActivityType != null)
        {
            <div class="category">
                @Model.Tip.ActivityType.Name
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Tip.VideoUrl))
        {
            <div class="media-box">
                <iframe src="@Model.Tip.VideoUrl" allowfullscreen></iframe>
            </div>
        }

        <div class="text-box">
            @Model.Tip.Content
        </div>

    </div>

</div>