@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.TipsPage.IndexModel

@{
    ViewData["Title"] = "Tips";
}

<style>
    body {
        background: #eef5ee;
        font-family: 'Segoe UI', sans-serif;
    }

    /* HEADER */
    .header {
        background: #4caf50;
        color: white;
        padding: 14px;
        text-align: center;
        font-weight: 600;
        position: relative;
    }

        .header .left {
            position: absolute;
            left: 15px;
        }

        .header .right {
            position: absolute;
            right: 15px;
        }

    .content {
        padding: 12px;
    }

    /* SECTION TITLE */
    .section-title {
        font-size: 13px;
        margin: 12px 0 6px;
        color: #1b3a1b;
        border-bottom: 1px solid #c8e6c9;
        padding-bottom: 3px;
    }

    /* LIST ITEMS */
    .list-item {
        background: #efe6dc;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
    }

        .list-item a {
            text-decoration: none;
            color: #1b3a1b;
            width: 100%;
            display: flex;
            justify-content: space-between;
        }

    .arrow {
        color: #666;
    }

    /* FOOTER */
    .footer {
        background: #e8f5e9;
        padding: 10px 0;
        display: flex;
        justify-content: space-around;
        border-top: 1px solid #c8e6c9;
    }

        .footer div {
            text-align: center;
            font-size: 12px;
            color: #2e7d32;
        }
</style>

<div class="app">

    <!-- HEADER -->
    <div class="header">
        <span class="left">⚙</span>
        Tips
        <span class="right">👤</span>
    </div>

    <div class="content">

        <!-- PERSONALISED -->
        <div class="section-title">Personalised Tips</div>

        @foreach (var tip in Model.RecommendedTips)
        {
            <div class="list-item">
                <a asp-page="./Details" asp-route-id="@tip.Id">
                    <span>@tip.Title</span>
                    <span class="arrow">›</span>
                </a>
            </div>
        }

        <!-- GENERAL -->
        <div class="section-title">
            General Tips
            <a asp-page="./AllTips" style="float:right; font-size:12px;">More</a>
        </div>

        @foreach (var tip in Model.GeneralTips)
        {
            <div class="list-item">
                <a asp-page="./Details" asp-route-id="@tip.Id">
                    <span>@tip.Title</span>
                    <span class="arrow">›</span>
                </a>
            </div>
        }

        <!-- FAQ -->
        <div class="section-title">
            FAQ
            <a asp-page="./AllFaqs" style="float:right; font-size:12px;">More</a>
        </div>

        @foreach (var faq in Model.FaqItems)
        {
            <div class="list-item">
                <a asp-page="./Details" asp-route-id="@faq.Id">
                    <span>@faq.Title</span>
                    <span class="arrow">›</span>
                </a>
            </div>
        }

    </div>

</div>