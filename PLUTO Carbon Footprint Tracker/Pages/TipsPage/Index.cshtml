@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.TipsPage.IndexModel

@{
    ViewData["Title"] = "Tips";
}

<h1>Tips</h1>

@if (!string.IsNullOrEmpty(Model.HighestCarbonActivityType))
{
    <p>Your highest carbon emission category is: <strong>@Model.HighestCarbonActivityType</strong></p>
}

@if (Model.RecommendedTips.Any())
{
    <div class="d-flex justify-content-between align-items-center">
        <h2>Recommended for You</h2>
        <a asp-page="./AllTips">See all &gt;</a>
    </div>

    <p>These tips are prioritised based on the category contributing the most CO₂ to your emissions.</p>

    <div class="card mb-3">
        @foreach (var tip in Model.RecommendedTips)
        {
            <div class="card-body border-bottom">
                <h4>@tip.Title</h4>
                <a asp-page="./Details" asp-route-id="@tip.Id" class="btn btn-primary">View Details</a>
            </div>
        }
    </div>
}

<div class="d-flex justify-content-between align-items-center">
    <h2>More Tips</h2>
    <a asp-page="./AllTips">See all &gt;</a>
</div>

<p>Here are some more tips to help you reduce your carbon footprint.</p>

<div class="card mb-3">
    @foreach (var tip in Model.GeneralTips)
    {
        <div class="card-body border-bottom">
            <h4>@tip.Title</h4>
            <a asp-page="./Details" asp-route-id="@tip.Id" class="btn btn-primary">View Details</a>
        </div>
    }
</div>

<div class="d-flex justify-content-between align-items-center">
    <h2>FAQ</h2>
</div>

<p>Frequently asked questions.</p>
<div class="card mb-3">
    @foreach (var faq in Model.FaqItems)
    {
        <div class="card-body border-bottom">
            <h4>@faq.Title</h4>
            <a asp-page="./Details" asp-route-id="@faq.Id" class="btn btn-primary">View Details</a>
        </div>
    }
</div>
