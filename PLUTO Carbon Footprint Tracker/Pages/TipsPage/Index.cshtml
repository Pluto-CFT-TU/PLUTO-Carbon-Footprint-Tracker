@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.TipsPage.IndexModel

@{
    ViewData["Title"] = "Tips";
}

<style>
    body {
        background: #eef5ee;
        font-family: 'Segoe UI', sans-serif;
    }

    .header {
        background: #4caf50;
        color: white;
        padding: 14px;
        text-align: center;
        font-weight: 600;
        position: relative;
    }

        .header .left {
            position: absolute;
            left: 15px;
        }

        .header .right {
            position: absolute;
            right: 15px;
        }

    .icon-btn {
        text-decoration: none;
        color: white;
        font-size: 18px;
        padding: 4px;
        border-radius: 6px;
    }

        .icon-btn:hover {
            background: rgba(255,255,255,0.2);
            color: white;
        }

    .content {
        padding: 12px;
    }

    .section-title {
        font-size: 13px;
        margin: 12px 0 6px;
        color: #1b3a1b;
        border-bottom: 1px solid #c8e6c9;
        padding-bottom: 3px;
    }

    .list-item {
        background: #efe6dc;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
    }

        .list-item a {
            text-decoration: none;
            color: #1b3a1b;
            width: 100%;
            display: flex;
            justify-content: space-between;
        }

    .arrow {
        color: #666;
    }

    .footer {
        background: #e8f5e9;
        padding: 10px 0;
        display: flex;
        justify-content: space-around;
        border-top: 1px solid #c8e6c9;
    }

        .footer div {
            text-align: center;
            font-size: 12px;
            color: #2e7d32;
        }
</style>

<div class="app">

    <div class="header">
        <a asp-page="/SettingsPage/Index" class="left icon-btn">⚙</a>
        Tips
        <a asp-page="/UserProfile/Index" class="right icon-btn">👤</a>
    </div>

    <div class="content">

        <div class="section-title">Personalised Tips</div>
        @if (!Model.RecommendedTips.Any())
        {
            <div class="empty-text">No personalised tips available. Please log more activities to get personalised advice</div>
		}
        @foreach (var tip in Model.RecommendedTips)
        {
            <div class="list-item">
                <a asp-page="./Details" asp-route-id="@tip.Id">
                    <span>@tip.Title</span>
                    <span class="arrow">›</span>
                </a>
            </div>
        }

        <div class="section-title">
            General Tips
            <a asp-page="./AllTips" style="float:right; font-size:12px;">More</a>
        </div>

        @foreach (var tip in Model.GeneralTips)
        {
            <div class="list-item">
                <a asp-page="./Details" asp-route-id="@tip.Id">
                    <span>@tip.Title</span>
                    <span class="arrow">›</span>
                </a>
            </div>
        }

        <div class="section-title">
            FAQ
            <a asp-page="./AllFaqs" style="float:right; font-size:12px;">More</a>
        </div>

        @foreach (var faq in Model.FaqItems)
        {
            <div class="list-item">
                <a asp-page="./Details" asp-route-id="@faq.Id">
                    <span>@faq.Title</span>
                    <span class="arrow">›</span>
                </a>
            </div>
        }

    </div>

</div>