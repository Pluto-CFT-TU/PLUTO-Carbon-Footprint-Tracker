@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.EmissionsLog.IndexModel

@{
    ViewData["Title"] = "Emission Log";
}

<style>
    body {
        background: #eef5ee;
        font-family: 'Segoe UI', sans-serif;
    }

    .app-container {
        max-width: 420px;
        margin: auto;
    }

    .card-main {
        background: linear-gradient(180deg, #9be15d, #6bcf63);
        border-radius: 25px;
        padding: 20px;
        color: #1b3a1b;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

    .date-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .circle {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        margin: 20px auto;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
       
        text-align: center;
    }

        .circle strong {
            font-size: 28px;
        }

    .section {
        margin-top: 15px;
    }

    .entry-card {
        background: #2e7d32;
        color: white;
        padding: 12px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

        .entry-card small {
            opacity: 0.8;
        }

    .btn-add {
        width: 100%;
        background: #1b5e20;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 10px;
        margin-top: 8px;
    }

        .btn-add:hover {
            background: #144d18;
        }

    .actions a {
        margin-left: 6px;
        font-size: 12px;
        color: white;
        opacity: 0.85;
        text-decoration: none;
    }

        .actions a:hover {
            opacity: 1;
        }

    .empty-state {
        text-align: center;
        padding: 15px;
        background: #dff0d8;
        border-radius: 12px;
        margin-top: 10px;
    }
</style>

<div class="app-container">

    <!-- TOP CARD -->
    <div class="card-main">

        <div class="date-bar">
            <span>@Model.SelectedDate.ToString("dd MMM")</span>

            <form method="get">
                <input type="date" name="selectedDate"
                       value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()"
                       style="border:none; background:transparent;" />
            </form>
        </div>

        <!-- CIRCLE TOTAL -->
        <div class="circle">
            <div>
                <strong>@Model.TotalCarbonKg.ToString("0.##")</strong><br />
                <small>kg today</small>
            </div>
        </div>

        <!-- GROUPED ENTRIES -->
        @if (Model.GroupedEntries.Any())
        {
            @foreach (var group in Model.GroupedEntries)
            {
                <div class="section">
                    <small>@group.Key</small>

                    @foreach (var entry in group.Value)
                    {
                        <div class="entry-card">
                            <div>
                                <div>@entry.Activity.Name</div>
                                <small>@entry.Quantity @entry.Activity.Unit</small>
                            </div>

                            <div>
                                @entry.CarbonKg.ToString("0.##") kg
                                <div class="actions">
                                    <a asp-page="./Edit"
                                       asp-route-id="@entry.Id"
                                       asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")">Edit</a>

                                    <a asp-page="./Details"
                                       asp-route-id="@entry.Id"
                                       asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")">View</a>

                                    <a asp-page="./Delete"
                                       asp-route-id="@entry.Id"
                                       asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")">Delete</a>
                                </div>
                            </div>
                        </div>
                    }

                    <a asp-page="./Search"
                       asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                       class="btn-add">
                        Add new
                    </a>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                No entries recorded for this day.
            </div>

            <a asp-page="./Search"
               asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
               class="btn-add">
                Add your first activity
            </a>
        }
    </div>
</div>