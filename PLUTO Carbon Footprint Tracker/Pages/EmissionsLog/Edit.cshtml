@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.EmissionsLog.EditModel

@{
    ViewData["Title"] = "Edit Emission Entry";
}

<h1>Edit</h1>

<h4>Emission Entry</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="EmissionEntry.Id" />
            <input type="hidden" asp-for="EmissionEntry.UserId" />
            <input type="hidden" asp-for="EmissionEntry.ActivityId" />
            <input type="hidden" asp-for="EmissionEntry.CreatedAt" />
            <input type="hidden" asp-for="EmissionEntry.EntryDate" />

            <div class="mb-3">
                <p><strong>Activity:</strong> @Model.ActivityName</p>
            </div>

            <div class="mb-3">
                <p><strong>Emission Factor:</strong> @Model.EmissionFactor.ToString() kg</p>
            </div>

            <div class="mb-3">
                <p><strong>Current Emission Amount:</strong> @Model.EmissionAmount.ToString() kg</p>
            </div>

            <div class="form-group">
                <label asp-for="EmissionEntry.Quantity" class="control-label"></label>
                <input asp-for="EmissionEntry.Quantity" class="form-control" />
                <span asp-validation-for="EmissionEntry.Quantity" class="text-danger"></span>
                <small class="form-text text-muted">
                    Unit: @Model.ActivityUnit
                </small>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}