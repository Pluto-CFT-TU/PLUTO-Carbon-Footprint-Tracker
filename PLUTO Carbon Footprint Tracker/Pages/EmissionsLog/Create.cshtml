@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.EmissionsLog.CreateModel

@{
    ViewData["Title"] = "Confirm Activity";
}

<h1>Confirm Activity</h1>

@if (Model.Activity != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <p><strong>Category:</strong> @Model.Activity.ActivityType.Name</p>
            <p><strong>Activity:</strong> @Model.Activity.Name</p>
            <p><strong>Factor:</strong> @Model.Activity.EmissionFactor per @Model.Activity.Unit</p>
        </div>
    </div>
}

<form method="post">
    <input type="hidden" asp-for="ActivityId" />
    <input type="hidden" asp-for="SelectedDate" />

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Quantity (@Model.Activity?.Unit)</label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Confirm</button>
    <a asp-page="./AddActivity" asp-route-selectedDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
       class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}