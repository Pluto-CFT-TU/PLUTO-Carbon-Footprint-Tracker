@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.SettingsPage.IndexModel

@{
    ViewData["Title"] = "Settings";
}

<h1>Settings</h1>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="Settings.Id" />
    <input type="hidden" asp-for="Settings.UserId" />

    <div class="card mb-3">
        <div class="card-body">
            <h4>Privacy Preferences</h4>

            <div class="form-check mb-2">
                <input asp-for="Settings.AllowAnalytics" class="form-check-input" />
                <label asp-for="Settings.AllowAnalytics" class="form-check-label">
                    Allow analytics
                </label>
            </div>

            <div class="form-check mb-2">
                <input asp-for="Settings.AllowMarketingEmails" class="form-check-input" />
                <label asp-for="Settings.AllowMarketingEmails" class="form-check-label">
                    Allow marketing emails
                </label>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h4>Accessibility</h4>

            <div class="form-group mb-3">
                <label asp-for="Settings.FontSize" class="control-label">Font Size</label>
                <select asp-for="Settings.FontSize" class="form-control">
                    <option value="14">Small</option>
                    <option value="16">Medium</option>
                    <option value="20">Large</option>
                    <option value="24">Extra Large</option>
                </select>
            </div>

            <div class="form-check mb-2">
                <input asp-for="Settings.HighContrast" class="form-check-input" />
                <label asp-for="Settings.HighContrast" class="form-check-label">
                    High contrast mode
                </label>
            </div>

            <div class="form-check mb-2">
                <input asp-for="Settings.TextToSpeech" class="form-check-input" />
                <label asp-for="Settings.TextToSpeech" class="form-check-label">
                    Text-to-speech enabled
                </label>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Settings.ColourBlindMode" class="control-label">Colour Blind Mode</label>
                <select asp-for="Settings.ColourBlindMode" class="form-control">
                    <option value="None">None</option>
                    <option value="Protanopia">Protanopia</option>
                    <option value="Deuteranopia">Deuteranopia</option>
                    <option value="Tritanopia">Tritanopia</option>
                </select>
            </div>
        </div>
    </div>

    <div class="form-group">
        <input type="submit" value="Save Settings" class="btn btn-primary" />
        <a asp-page="/UserProfile/Index" class="btn btn-secondary">Back to Profile</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}