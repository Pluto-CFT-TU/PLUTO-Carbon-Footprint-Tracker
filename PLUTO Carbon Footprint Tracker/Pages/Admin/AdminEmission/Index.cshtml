@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.Admin.AdminEmission.IndexModel

@{
    ViewData["Title"] = "Manage Emission Activities";
}

<h1>Manage Emission Activities</h1>

<p>
    <a asp-page="Create" class="btn btn-success">Create New Activity</a>
</p>

<form method="get" class="mb-3">
    <div class="mb-3">
        <label for="searchTerm" class="form-label">Search</label>
        <input type="text" id="searchTerm" name="searchTerm"
            value="@Model.SearchTerm" class="form-control"
            placeholder="Search activity, unit, or category..." />
    </div>

    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-page="./Index" class="btn btn-secondary">Clear</a>
</form>

@if (Model.ActivityItems.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Category</th>
                <th>Activity</th>
                <th>Unit</th>
                <th>Emission Factor</th>
                <th>Active</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ActivityItems)
            {
                <tr>
                    <td>@item.ActivityTypeName</td>
                    <td>@item.ActivityName</td>
                    <td>@item.Unit</td>
                    <td>@item.EmissionFactor</td>
                    <td>@item.IsActive</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">Details</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No matching activities found.</p>
}