@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.Admin.AdminEmission.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Activity</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Activity.Id" />
            <div class="form-group">
                <label asp-for="Activity.ActivityTypeId" class="control-label"></label>
                <select asp-for="Activity.ActivityTypeId" class="form-control" asp-items="ViewBag.ActivityTypeId" ></select>
                <span asp-validation-for="Activity.ActivityTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Activity.Name" class="control-label"></label>
                <input asp-for="Activity.Name" class="form-control" />
                <span asp-validation-for="Activity.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Activity.Unit" class="control-label"></label>
                <input asp-for="Activity.Unit" class="form-control" />
                <span asp-validation-for="Activity.Unit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Activity.EmissionFactor" class="control-label"></label>
                <input asp-for="Activity.EmissionFactor" class="form-control" />
                <span asp-validation-for="Activity.EmissionFactor" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Activity.IsActive" /> @Html.DisplayNameFor(model => model.Activity.IsActive)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
