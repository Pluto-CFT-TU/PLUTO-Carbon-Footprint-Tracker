@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.Admin.AdminTips.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Tips</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Tips.ActivityTypeId" class="control-label"></label>
                <select asp-for="Tips.ActivityTypeId" class ="form-control" asp-items="ViewBag.ActivityTypeId" ></select>
            </div>
            <div class="form-group">
                <label asp-for="Tips.Title" class="control-label"></label>
                <input asp-for="Tips.Title" class="form-control" />
                <span asp-validation-for="Tips.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tips.Content" class="control-label"></label>
                <input asp-for="Tips.Content" class="form-control" />
                <span asp-validation-for="Tips.Content" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tips.VideoUrl" class="control-label"></label>
                <input asp-for="Tips.VideoUrl" class="form-control" />
                <span asp-validation-for="Tips.VideoUrl" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Tips.IsFaq" /> @Html.DisplayNameFor(model => model.Tips.IsFaq)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
