@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.Admin.AdminTips.EditModel

@{
    ViewData["Title"] = "Edit Tip or FAQ";
}

<h1>Edit</h1>

<h4>Tip / FAQ</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Tips.Id" />

            <div class="form-group">
                <label asp-for="Tips.ActivityTypeId" class="control-label">Activity Type</label>
                <select asp-for="Tips.ActivityTypeId" asp-items="Model.ActivityTypeItems" class="form-control">
                    <option value="">-- General / FAQ --</option>
                </select>
                <span asp-validation-for="Tips.ActivityTypeId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Tips.Title" class="control-label"></label>
                <input asp-for="Tips.Title" class="form-control" />
                <span asp-validation-for="Tips.Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Tips.Content" class="control-label"></label>
                <textarea asp-for="Tips.Content" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Tips.Content" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Tips.VideoUrl" class="control-label">Video URL</label>
                <input asp-for="Tips.VideoUrl" class="form-control" />
                <span asp-validation-for="Tips.VideoUrl" class="text-danger"></span>
                <small class="form-text text-muted">
                    Optional. Use an embed URL for YouTube videos.
                </small>
            </div>

            <div class="form-group form-check mt-2">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Tips.IsFaq" />
                    Is this an FAQ?
                </label>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}