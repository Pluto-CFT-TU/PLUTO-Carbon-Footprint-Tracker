@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.Admin.AdminNews.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3 class="text-danger">Are you sure you want to delete this article?</h3>

<div>
    <h4>News Article</h4>
    <hr />

    @if (!string.IsNullOrWhiteSpace(Model.NewsArticle.ImageUrl))
    {
        <div class="mb-3">
            <img src="@Model.NewsArticle.ImageUrl"
                 alt="@Model.NewsArticle.Title"
                 class="img-fluid rounded"
                 style="max-height: 250px; object-fit: cover; width: 100%;" />
        </div>
    }

    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.NewsArticle.Title</dd>

        <dt class="col-sm-2">Summary</dt>
        <dd class="col-sm-10">@Model.NewsArticle.Summary</dd>

        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@(Model.NewsArticle.Category ?? "General")</dd>

        <dt class="col-sm-2">Published</dt>
        <dd class="col-sm-10">@(Model.NewsArticle.IsPublished ? "Yes" : "No")</dd>

        <dt class="col-sm-2">Published Date</dt>
        <dd class="col-sm-10">@Model.NewsArticle.PublishedAt.ToString("dd MMM yyyy")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="NewsArticle.Id" />

        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>