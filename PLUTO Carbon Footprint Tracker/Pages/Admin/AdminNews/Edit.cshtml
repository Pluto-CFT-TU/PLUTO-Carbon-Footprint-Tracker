@page
@model PLUTO_Carbon_Footprint_Tracker.Pages.Admin.AdminNews.EditModel

@{
    ViewData["Title"] = "Edit News Article";
}

<h1>Edit</h1>

<h4>News Article</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="NewsArticle.Id" />
            <input type="hidden" asp-for="NewsArticle.PublishedAt" />

            <div class="form-group">
                <label asp-for="NewsArticle.Title" class="control-label"></label>
                <input asp-for="NewsArticle.Title" class="form-control" />
                <span asp-validation-for="NewsArticle.Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewsArticle.Summary" class="control-label"></label>
                <input asp-for="NewsArticle.Summary" class="form-control" />
                <span asp-validation-for="NewsArticle.Summary" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewsArticle.Content" class="control-label"></label>
                <textarea asp-for="NewsArticle.Content" class="form-control" rows="5"></textarea>
                <span asp-validation-for="NewsArticle.Content" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewsArticle.ImageUrl" class="control-label">News Image</label>
                <select asp-for="NewsArticle.ImageUrl" asp-items="Model.ImageItems" class="form-control">
					<option value="">-- Select --</option>
                </select>
                <span asp-validation-for="NewsArticle.ImageUrl" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.NewsArticle.ImageUrl))
            {
                <div class="mt-2 mb-3">
                    <p><strong>Current image preview:</strong></p>
                    <img src="@Model.NewsArticle.ImageUrl"
                         alt="@Model.NewsArticle.Title"
                         class="img-fluid rounded"
                         style="max-height: 220px; object-fit: cover; width: 100%;" />
                </div>
            }

            <div class="form-group">
                <label asp-for="NewsArticle.Category" class="control-label"></label>
                <input asp-for="NewsArticle.Category" class="form-control" />
                <span asp-validation-for="NewsArticle.Category" class="text-danger"></span>
            </div>

            <div class="form-group form-check mt-2">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="NewsArticle.IsPublished" />
                    Is Published
                </label>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}